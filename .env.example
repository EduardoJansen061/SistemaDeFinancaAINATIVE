# =============================================
# FinançasPRO — Environment Variables Template
# Copie este arquivo para .env e preencha os valores
# =============================================

# === BANCO DE DADOS ===
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_DATABASE=financaspro
MYSQL_USER=financaspro_user
MYSQL_PASSWORD=financaspro_pass_change_me

# === JWT ===
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_me
JWT_EXPIRES_IN=7d

# === URLS ===
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api

# === N8N WEBHOOK (opcional) ===
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/financaspro

# === AMBIENTE ===
NODE_ENV=development
